# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=http://localhost:3000

# Firebase Configuration
FIREBASE_PROJECT_ID=scholarsaathi-549cd
# Optional: Path to service account key file, or base64 encoded JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional: Set to true if testing in offline/mock mode without live GCP credentials
USE_FIREBASE_EMULATOR_OR_MOCK=false
FIREBASE_STORAGE_BUCKET=scholarsaathi-549cd.appspot.com

# Google Gemini API Configuration (Server-Side ONLY - Never expose to client)
GEMINI_API_KEY=
GEMINI_MODEL_FLASH=gemini-1.5-flash
GEMINI_MODEL_PRO=gemini-1.5-pro

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
